# Arbiter environment template - copy to .env and fill in your own values.
# Nothing here is a real secret. Do NOT commit your real .env (it is gitignored).

# --- Stripe (TEST MODE ONLY) ---
# The ONLY secret Arbiter actually needs. Use a test-mode key (sk_test_...).
# Get yours from the Stripe dashboard: Developers -> API keys (Test mode).
# When this is set, the live test-mode Stripe rail activates; if unset, Arbiter
# falls back to a no-money stub.
STRIPE_SECRET_KEY=replace_with_your_stripe_test_key

# Optional platform config (these have sensible defaults if omitted).
STRIPE_PLATFORM_COUNTRY=GB
STRIPE_PLATFORM_CURRENCY=gbp

# --- NVIDIA NIM (OPTIONAL) ---
# You do NOT need this to run/test. If NVIDIA_API_KEY is unset, the Nemotron
# layer falls back to a built-in mock, so the full flow still works.
# If you want real Nemotron responses, use YOUR OWN free NVIDIA key here -
# do not use someone else's. NVIDIA_NIM_KEY is accepted as an alias.
# NVIDIA_API_KEY=replace_with_your_nvidia_key
# Optional override if your key has no inference entitlement and 403s:
# NVIDIA_NIM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=replace_with_your_openrouter_key

